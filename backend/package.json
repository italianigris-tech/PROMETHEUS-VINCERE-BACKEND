{
  "name": "@prometheus/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./audio/mix-audio": "./src/audio/mix-audio.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "music:rehearsal": "tsx src/music/scripts/run-music-rehearsal.ts",
    "music:preflight": "tsx src/music/scripts/validate-music-preflight.ts",
    "music:preview-mix": "tsx src/music/scripts/render-music-preview-mix.ts",
    "music:dj:smoke": "tsx src/music/scripts/music-dj-smoke.ts",
    "music:catalog:normalize": "tsx src/music/scripts/normalize-r2-music-catalog.ts",
    "music:catalog:smoke": "tsx src/music/scripts/smoke-music-catalog-api.ts",
    "maul:work-once": "tsx src/maul/run-worker.ts",
    "audio:sfx:catalog": "tsx src/audio/catalog/scan-sfx-catalog.ts",
    "music:upload:r2": "tsx src/music/scripts/upload-music-library-to-r2.ts",
    "test": "vitest run --pool threads",
    "test:watch": "vitest --pool threads",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1030.0",
    "@aws-sdk/s3-request-presigner": "^3.1030.0",
    "@fastify/cors": "^8.5.0",
    "@fastify/multipart": "^8.3.1",
    "@fastify/websocket": "^10.0.1",
    "@prometheus/shared-types": "*",
    "@types/fontkit": "^2.0.9",
    "@zilliz/milvus2-sdk-node": "^2.6.13",
    "adm-zip": "^0.5.17",
    "dotenv": "^17.4.2",
    "fastify": "^4.29.1",
    "fontkit": "^2.0.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^25.3.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.1.4"
  }
}
