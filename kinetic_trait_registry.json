      "conflictsWith": ["hand_drawn_svg_path"],
      "renderMode": "frame-deterministic",
      "frameExpression": {
        "staggerOffsetFrames": 2.4,
        "rotateX": "max(0, -90 + ((frame - glyphIndex * 2.4) / 20) * 90)",
        "translateY": "max(0, 28 - ((frame - glyphIndex * 2.4) / 20) * 28)",
        "blurPx": "max(0, 10 - ((frame - glyphIndex * 2.4) / 20) * 10)"
      },
      "cost": { "domNodes": 12, "filters": 1 },
      "readabilityLimits": { "maxWords": 3 }
    },
