  "name": "Prometheus Kinetic Reference Trait Extraction Registry",
  "version": "1.4.0",
  "description": "Decomposed atomic kinetic traits extracted from reference phenotypes (TYPO #01 - #26, excluding #24) for governed Treatment Genome composition.",
  "traits": [
    {
      "id": "trait_blur_up_reveal",
      "name": "Sub-Pixel Blur-Up Mask Reveal",
      "sourcePhenotype": "TYPO #04 (subpixel-blur-mask)",
      "concern": "MotionPhysics",
      "targetScope": "word",
      "targetRoles": ["hero", "support"],
      "ownsChannels": ["filter.blur", "opacity", "transform.scale"],
      "requires": [],
      "conflictsWith": ["gooey_metaball_filter"],
      "renderMode": "frame-deterministic",
      "frameExpression": {
        "opacity": "clamp((frame / 30), 0, 1)",
        "blurPx": "max(0, 26 - (frame / 30) * 26)",
        "scale": "0.90 + clamp((frame / 30), 0, 1) * 0.10"
      },
      "cost": { "domNodes": 1, "filters": 1 },
      "readabilityLimits": { "maxWords": 6 }
    },
    {
      "id": "trait_staggered_rotate_x",
