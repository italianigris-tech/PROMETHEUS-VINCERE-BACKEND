# ============================================
# PROMETHEUS ORCHESTRATOR — ENVIRONMENT CONFIG
# ============================================

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram Chat IDs allowed to control the bot (comma-separated)
# Get your chat ID by messaging the bot, then check logs
AUTHORIZED_CHAT_IDS=your_chat_id_here

# GitHub Configuration
GITHUB_TOKEN=ghp_your_personal_access_token
GITHUB_OWNER=igrisundead-ops
GITHUB_REPO=PROMETHEUS-CORE-BACKEND

# Issue label to filter tasks
ISSUE_LABEL=ready-for-agent

# Codex Configuration
# Primary API key (OpenAI)
CODEX_API_KEY=sk-your-openai-key
# Fallback API keys (comma-separated, used when primary exhausts)
CODEX_FALLBACK_KEYS=sk-fallback-key-1,sk-fallback-key-2

# Default Codex model (can be overridden via Telegram)
# Options: gpt-5.4, gpt-5.5, gpt-5.5-high, gpt-5.5-xhigh
CODEX_DEFAULT_MODEL=gpt-5.5

# Repository path on EC2 (where to clone/work)
REPO_PATH=/home/ec2-user/prometheus-backend

# Polling interval (seconds)
POLL_INTERVAL=30

# Working directory for Codex
CODEX_WORKDIR=/home/ec2-user/prometheus-backend

# Codex timeout limits (minutes)
CODEX_MAX_RUNTIME_MINUTES=30
CODEX_NO_OUTPUT_TIMEOUT_MINUTES=10

# Proxy resilience tuning
PROXY_HEALTH_URL=https://codex-everywhere.com/health
PROXY_HEALTH_TIMEOUT_MS=3000
MAX_HEALTH_RETRIES=3
CODEX_OUTER_RETRIES=3
CODEX_OUTER_RETRY_DELAYS=30000,120000,300000
COOLDOWN_AFTER_503_MS=10000
