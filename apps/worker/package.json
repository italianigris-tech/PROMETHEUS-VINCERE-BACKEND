{
  "name": "@prometheus/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm --prefix ../../packages/shared-types run build && tsc -p tsconfig.json",
    "bundle": "remotion bundle src/remotion-entry.tsx --out-dir dist/remotion-bundle",
    "preview": "remotion preview src/remotion-entry.tsx",
    "studio": "remotion studio src/remotion-entry.tsx --force-new",
    "compositions": "remotion compositions src/remotion-entry.tsx",
    "render:sample": "remotion render src/remotion-entry.tsx PrometheusRegenerateSample out/regenerate-sample.mp4 --codec=h264 --audio-codec=aac",
    "render:manifest": "tsx scripts/render-manifest.ts",
    "render:landscape": "tsx scripts/render-landscape.ts",
    "lambda:deploy": "tsx scripts/deploy-remotion-lambda.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@prometheus/backend": "file:../../backend",
    "@prometheus/shared-types": "file:../../packages/shared-types",
    "@react-three/fiber": "8.16.8",
    "@react-three/postprocessing": "^2.16.0",
    "@remotion/bundler": "4.0.471",
    "@remotion/captions": "4.0.471",
    "@remotion/cli": "4.0.471",
    "@remotion/fonts": "4.0.471",
    "@remotion/google-fonts": "4.0.471",
    "@remotion/lambda": "4.0.471",
    "@remotion/media": "4.0.471",
    "@remotion/renderer": "4.0.471",
    "gsap": "3.12.7",
    "postprocessing": "^6.35.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "remotion": "4.0.471",
    "three": "0.160.1",
    "troika-three-text": "0.49.1",
    "troika-three-utils": "0.49.0",
    "zod": "3.23.8",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@types/node": "20.14.15",
    "@types/react": "18.2.79",
    "@types/react-dom": "18.2.25",
    "@types/three": "0.160.0",
    "typescript": "5.4.5",
    "vitest": "^3.1.4"
  }
}
